{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "components/brand/**",
              "components/core/**",
              "components/data/**",
              "ui_kits/portfolio/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:JetBrains Mono|VT323|Space Grotesk|IBM Plex Mono|DM Serif Display))/i]",
        "message": "Font not provided by the design system. Available: JetBrains Mono, VT323, Space Grotesk, IBM Plex Mono, DM Serif Display."
      },
      {
        "selector": "JSXOpeningElement[name.name='AsciiDivider'] > JSXAttribute > JSXIdentifier[name!=/^(?:glyph|color|size|gap|key|ref|className|style|children)$/]",
        "message": "<AsciiDivider> doesn't accept that prop. Declared props: glyph, color, size, gap."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|kind|disabled|onClick|style|key|ref|className|style|children)$/]",
        "message": "<Button> doesn't accept that prop. Declared props: children, kind, disabled, onClick, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='kind'] > Literal[value!=/^(?:primary|secondary|acid|pink|cobalt|ghost)$/]",
        "message": "<Button> kind must be one of 'primary' | 'secondary' | 'acid' | 'pink' | 'cobalt' | 'ghost'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Caret'] > JSXAttribute > JSXIdentifier[name!=/^(?:color|width|height|key|ref|className|style|children)$/]",
        "message": "<Caret> doesn't accept that prop. Declared props: color, width, height."
      },
      {
        "selector": "JSXOpeningElement[name.name='DataTableColumn'] > JSXAttribute > JSXIdentifier[name!=/^(?:key|label|align|strong|key|ref|className|style|children)$/]",
        "message": "<DataTableColumn> doesn't accept that prop. Declared props: key, label, align, strong."
      },
      {
        "selector": "JSXOpeningElement[name.name='DataTableColumn'] > JSXAttribute[name.name='align'] > Literal[value!=/^(?:left|right)$/]",
        "message": "<DataTableColumn> align must be one of 'left' | 'right'."
      },
      {
        "selector": "JSXOpeningElement[name.name='EntryCard'] > JSXAttribute > JSXIdentifier[name!=/^(?:kind|code|title|excerpt|meta|thumb|stamp|onClick|key|ref|className|style|children)$/]",
        "message": "<EntryCard> doesn't accept that prop. Declared props: kind, code, title, excerpt, meta, thumb, stamp, onClick."
      },
      {
        "selector": "JSXOpeningElement[name.name='Halftone'] > JSXAttribute > JSXIdentifier[name!=/^(?:width|height|density|label|src|key|ref|className|style|children)$/]",
        "message": "<Halftone> doesn't accept that prop. Declared props: width, height, density, label, src."
      },
      {
        "selector": "JSXOpeningElement[name.name='Halftone'] > JSXAttribute[name.name='density'] > Literal[value!=/^(?:low|medium|high)$/]",
        "message": "<Halftone> density must be one of 'low' | 'medium' | 'high'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Highlighter'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|color|key|ref|className|style|children)$/]",
        "message": "<Highlighter> doesn't accept that prop. Declared props: children, color."
      },
      {
        "selector": "JSXOpeningElement[name.name='Input'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|badge|helper|error|style|key|ref|className|style|children)$/]",
        "message": "<Input> doesn't accept that prop. Declared props: label, badge, helper, error, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='MetaPair'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|value|sub|labelWidth|key|ref|className|style|children)$/]",
        "message": "<MetaPair> doesn't accept that prop. Declared props: label, value, sub, labelWidth."
      },
      {
        "selector": "JSXOpeningElement[name.name='MetaStripItem'] > JSXAttribute > JSXIdentifier[name!=/^(?:key|value|sub|icon|key|ref|className|style|children)$/]",
        "message": "<MetaStripItem> doesn't accept that prop. Declared props: key, value, sub, icon."
      },
      {
        "selector": "JSXOpeningElement[name.name='Panel'] > JSXAttribute > JSXIdentifier[name!=/^(?:title|code|children|stamp|tone|key|ref|className|style|children)$/]",
        "message": "<Panel> doesn't accept that prop. Declared props: title, code, children, stamp, tone."
      },
      {
        "selector": "JSXOpeningElement[name.name='Panel'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:paper|recessed)$/]",
        "message": "<Panel> tone must be one of 'paper' | 'recessed'."
      },
      {
        "selector": "JSXOpeningElement[name.name='PixlGlyph'] > JSXAttribute > JSXIdentifier[name!=/^(?:size|color|live|key|ref|className|style|children)$/]",
        "message": "<PixlGlyph> doesn't accept that prop. Declared props: size, color, live."
      },
      {
        "selector": "JSXOpeningElement[name.name='Stamp'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|color|bg|size|key|ref|className|style|children)$/]",
        "message": "<Stamp> doesn't accept that prop. Declared props: children, color, bg, size."
      },
      {
        "selector": "JSXOpeningElement[name.name='Stamp'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:sm|md)$/]",
        "message": "<Stamp> size must be one of 'sm' | 'md'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Tag'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|variant|color|dot|key|ref|className|style|children)$/]",
        "message": "<Tag> doesn't accept that prop. Declared props: children, variant, color, dot."
      },
      {
        "selector": "JSXOpeningElement[name.name='Tag'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:outline|solid|acid|dashed)$/]",
        "message": "<Tag> variant must be one of 'outline' | 'solid' | 'acid' | 'dashed'."
      },
      {
        "selector": "JSXOpeningElement[name.name='TechMarker'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|top|left|right|bottom|color|key|ref|className|style|children)$/]",
        "message": "<TechMarker> doesn't accept that prop. Declared props: children, top, left, right, bottom, color."
      }
    ]
  },
  "overrides": [
    {
      "files": [
        "**/index.js"
      ],
      "rules": {
        "no-restricted-imports": "off"
      }
    }
